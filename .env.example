# The assistant stays off unless this is exactly true.
# Leave it unset, or set it to false, to make no AI calls.
AI_CHAT_ENABLED=false

# Server-only. Put a new key here after rotating the old one in console.x.ai.
# Do not commit the real value.
XAI_API_KEY=

# Chat questions use the same FormSubmit address as the contact form in js/email.js.
# Leave ADMIN_EMAIL unset to keep stormychaseforrester@gmail.com, with
# hello@techaidaustralia.com.au copied, matching that form.
# ADMIN_EMAIL=
# CONTACT_CC=

# Set to true only for a local test. Live Vercel should leave this unset so mail is sent.
# CONTACT_DRY_RUN=
